    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a friendly business development representative. Write a short, warm, personalized outreach email to a new lead based on their specific requirement. Do NOT use a generic template — reference their exact request.\n\nLead name: {{ $('Prepare Lead').item.json.Name }}\nTheir requirement: {{ $('Prepare Lead').item.json.Requirement }}\n\nGuidelines:\n- Greet the lead by their first name.\n- Reference their specific requirement in your own words.\n- Say we would be happy to help and can discuss the best approach.\n- Offer to schedule a quick discussion.\n- Keep it concise (3-5 short sentences), professional and warm.\n- Output only the email body text (no subject line, no placeholders).",
        "batching": {}
      },
