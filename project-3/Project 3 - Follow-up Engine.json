    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst pad = (n) => String(n).padStart(2, \"0\");\nconst now = new Date();\nconst todayDate = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;\nconst results = [];\nfor (const item of rows) {\n  const r = item.json || {};\n  if (!r.CreatedDate || !r.Email) continue;\n  if (String(r.Status).trim() !== \"New\") continue;\n  const created = new Date(r.CreatedDate);\n  if (isNaN(created.getTime())) continue;\n  const daysElapsed = Math.floor((now - created) / (1000 * 60 * 60 * 24));\n  const day3Done = String(r.Day3).trim().toLowerCase() === \"yes\";\n  const day5Done = String(r.Day5).trim().toLowerCase() === \"yes\";\n  const converted = String(r.Converted).trim().toLowerCase() === \"yes\";\n  let followupType = null;\n  if (daysElapsed >= 5 && !day5Done && !converted) {\n    followupType = \"day5\";\n  } else if (daysElapsed >= 3 && !day3Done) {\n    followupType = \"day3\";\n  }\n  if (!followupType) continue;\n  results.push({ json: { ...r, daysElapsed, followupType, todayDate } });\n}\nreturn results;"
      },
      "id": "6e502879-8699-4e09-a1d9-b3b50cf543dc",
      "name": "Compute Follow-ups",
