    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a short, warm Day 3 follow-up email to a lead who has not yet responded. Reference their specific requirement — do not use a generic template.\n\nLead name: {{ $('Compute Follow-ups').item.json.Name }}\nTheir requirement: {{ $('Compute Follow-ups').item.json.Requirement }}\n\nGuidelines:\n- Greet the lead by first name.\n- Gently follow up regarding their specific requirement.\n- Offer to discuss the project and help plan next steps.\n- Invite them to let us know if they would like to continue.\n- Keep it to 3-4 short sentences, friendly and professional.\n- Output only the email body text.",
        "batching": {}
